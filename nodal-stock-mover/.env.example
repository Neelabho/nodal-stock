# Copy to .env (never commit .env). Every value is optional; defaults are shown.

# --- AI (local Ollama only; no third-party LLM API) ---
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3:8b
OLLAMA_TIMEOUT=90
OLLAMA_RETRIES=2
# OLLAMA_API_KEY=            # only if Ollama sits behind an authenticated proxy
AI_REVIEW_LIMIT=60           # how many top-priority moves Qwen3 reviews per run

# --- storage ---
# DATABASE_URL=postgresql://user:pass@host:5432/nodal     # default: SQLite file in data/
# --- server ---
# NODAL_MODE=auto            # auto | published (public viewer, no ML libs) | compute
# NODAL_ADMIN_TOKEN=         # enables /api/admin/* (dataset upload, run); leave unset to disable
# --- daily automation ---
NODAL_TZ=Asia/Kolkata
NODAL_DAILY_TIME=06:00
# NODAL_INBOX=data/inbox     # watched folder for new datasets
# NODAL_DATA_DIR=            # fallback dataset folder (default: the supplied Manyavar CSVs)
# NODAL_NOTIFY_WEBHOOK=      # optional: POST {"text": ...} when a run finishes
