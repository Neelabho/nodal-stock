# Copy to .env (never commit .env). Every value is optional; defaults are shown.

# --- AI (local Ollama only; no third-party LLM API) ---
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3:8b
OLLAMA_TIMEOUT=90
OLLAMA_RETRIES=2
# OLLAMA_API_KEY=            # only if Ollama sits behind an authenticated proxy
AI_REVIEW_LIMIT=60           # how many top-priority moves Qwen3 reviews per run

# --- storage ---
# DATABASE_URL=postgresql://user:pass@host:5432/nodal     # default: SQLite file in data/
# --- server ---
# NODAL_MODE=auto            # auto | published (public viewer, no ML libs) | compute
# NODAL_ADMIN_TOKEN=         # enables /api/admin/* (dataset upload, run); leave unset to disable
# --- daily automation ---
NODAL_TZ=Asia/Kolkata
NODAL_DAILY_TIME=06:00
# NODAL_INBOX=data/inbox     # watched folder for new datasets
# NODAL_DATA_DIR=            # fallback dataset folder (default: the supplied Manyavar CSVs)
# NODAL_NOTIFY_WEBHOOK=      # optional: POST {"text": ...} when a run finishes

# --- Ask (Sarvam AI for general questions; plan questions never leave the machine) ---
# SARVAM_API_KEY=            # set in your environment / host settings, never commit it
SARVAM_MODEL=sarvam-105b-conversations
QA_PER_MINUTE=6              # questions per client per minute
QA_PER_DAY=40                # uncached Sarvam calls per client per day
QA_GLOBAL_PER_DAY=300        # uncached Sarvam calls for everyone per day
# NODAL_OVERLAYS=data/overlay   # where partial uploads are layered over the supplied data

# --- AI fallback: local Qwen3 first; if it is unavailable, Sarvam AI answers instead (same safety checks) ---
AI_REMOTE_FALLBACK=1         # 1 = Sarvam AI is used (the default); 0 = turn ALL AI off (nothing is sent to Sarvam)
AI_REMOTE_MAX_CALLS=200      # cap on Sarvam calls per process / pipeline run
# AI_USE_LOCAL=0           # local Ollama model is OFF; set 1 only to experiment with it
